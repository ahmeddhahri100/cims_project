# TEMPLATE ONLY - copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must never be committed.

# Server Configuration
PORT=3000
SESSION_SECRET=CHANGE_ME

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=CIMS
CLIENT_ID=cims-backend
CLIENT_SECRET=CHANGE_ME

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# PostgreSQL (n8n database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=CHANGE_ME

# n8n Webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/CHANGE_ME

# n8n Chatbot Webhook URL
N8N_CHATBOT_URL=http://localhost:5678/webhook/CHANGE_ME

# CIMS K8s Monitor webhook (set to /webhook/cims-monitor for production mode)
N8N_CIMS_WEBHOOK=http://localhost:5678/webhook/cims-monitor
# TEMPLATE ONLY - copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must never be committed.
#
# NOTE: Vite inlines every VITE_* variable into the client bundle, so these
# values end up visible in the browser. Never put a real server-side secret
# here. See ../.env.example for the backend secrets.

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=platform-voc
VITE_KEYCLOAK_CLIENT_ID=platform-voc-client
VITE_KEYCLOAK_CLIENT_SECRET=